# VolkaPortal Nginx reverse proxy template
#
# Usage:
# 1. Copy this file to /etc/nginx/sites-available/volkaportal
# 2. Update certificate paths after certbot creates the certificate.
# 3. Enable with:
#    ln -s /etc/nginx/sites-available/volkaportal /etc/nginx/sites-enabled/volkaportal
# 4. Test and reload:
#    nginx -t && systemctl reload nginx

server {
    listen 80;
    server_name volkaportal.com www.volkaportal.com *.volkaportal.com;

    client_max_body_size 25M;

    location /.well-known/acme-challenge/ {
        root /var/www/html;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl http2;
    server_name volkaportal.com www.volkaportal.com *.volkaportal.com;

    client_max_body_size 25M;

    ssl_certificate /etc/letsencrypt/live/volkaportal.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/volkaportal.com/privkey.pem;
    include /etc/letsencrypt/options-ssl-nginx.conf;
    ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem;

    location / {
        proxy_pass http://127.0.0.1:8000;

        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Forwarded-Port $server_port;

        proxy_read_timeout 120s;
        proxy_connect_timeout 30s;
        proxy_send_timeout 120s;
    }
}
