[Unit]
Description=VolkaPortal webhook delivery dispatcher
After=network-online.target aksiyon-takip.service
Wants=network-online.target

[Service]
Type=oneshot
User=aksiyon
Group=aksiyon
WorkingDirectory=/var/www/aksiyon-takip
Environment=DATA_DIR=/var/data/aksiyon-takip
Environment=APP_ENV=production
Environment=AUTO_BOOTSTRAP_DATABASE=false
EnvironmentFile=/etc/aksiyon-takip/integrations.env
TimeoutStartSec=12min
ExecStart=/var/www/aksiyon-takip/venv-py312/bin/python -m flask --app app:create_app dispatch-webhooks --limit 50

[Install]
WantedBy=multi-user.target
